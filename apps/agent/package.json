{
  "name": "@archcore/agent",
  "version": "0.1.0",
  "private": true,
  "description": "ARCHcore Provider Agent — reservation detection, EIP-712 renter auth, fixed-model inference proxy, expiry enforcement",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters --noImplicitReturns --noFallthroughCasesInSwitch",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "node --test --import tsx test/*.test.ts",
    "test:report": "node --test --import tsx --test-reporter=tap test/*.test.ts"
  },
  "dependencies": {
    "@archcore/chain": "*",
    "@archcore/shared": "*",
    "@fastify/cors": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}
