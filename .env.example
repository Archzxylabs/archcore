# ARCHcore P0 v0.5 — sanitized names/examples only; never put real secrets here.
# Product values are frozen in docs/ARCHcore_PRD_P0_v0.5_END_TO_END.md.

# Provider Agent chain configuration (server-side; keep credentialed RPC private)
RH_CHAIN_ID=46630
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
RENTAL_MANAGER_ADDRESS=
COMPUTE_ASSET_ADDRESS=
ARCHCORE_NODE_ID=1

# Rental token is fixed by PRD; no environment override is permitted.
USDG_ADDRESS=0x7E955252E15c84f5768B83c41a71F9eba181802F
# Onchain deployment preflight MUST verify decimals() == 6. Do not rescale if it differs.

# Paths to source-generated ABI artifacts; never use hand-written production ABI.
RENTAL_MANAGER_ABI_PATH=
COMPUTE_ASSET_ABI_PATH=
# Blank uses packages/abi relative to the chain package, independent of startup cwd.
# Any explicit override must be an absolute path to the current generated artifact.

# Provider transaction signer: configure an operator-approved secure signer
# mechanism outside this template. Do not put private-key material in this file.
# Its public address must equal rental.provider for the observed reservation.
PROVIDER_PRIVATE_KEY=
# Current local Agent accepts a testnet private key from its uncommitted operator
# environment. Never paste it into reports or Web. An alternate signer is future work.

# Agent binds to loopback by default; renter access is through operator-configured
# private OmniRoute. These invalid example origins are documentation placeholders.
AGENT_PORT=8787
AGENT_HOST=127.0.0.1
AGENT_AUTO_START=false
# Enable explicitly only when authorizing the provider to send startRental transactions.
AGENT_AUTO_SETTLE=false
# Enable explicitly (true) only when authorizing the provider signer to spend gas
# automatically submitting settleAfterExpiry transactions. Missing defaults to false.
# AGENT_SETTLE_MAX_ATTEMPTS=5
# AGENT_SETTLE_RETRY_DELAY_MS=2000
# SQLite durable transaction journal for Provider Agent auto-settlement recovery.
# Local development defaults to repository-relative apps/agent/data/settlement.sqlite.
# Production deployments MUST use a persistent volume mount, recommended:
# /var/lib/archcore/settlement.sqlite
# AGENT_SETTLEMENT_DB_PATH=/var/lib/archcore/settlement.sqlite
# AGENT_SETTLE_CLAIM_LEASE_MS=30000
# AGENT_SETTLE_BUSY_TIMEOUT_MS=5000
AGENT_LOG_LEVEL=info
AGENT_ALLOWED_ORIGINS=https://agent.example.invalid
AGENT_AUDIENCE=https://agent.example.invalid

# P0 inference mode is explicit and has no fallback. This is a runnable simulated
# Demo Inference Backend, distinct from test-only fakes; it does not imply GPU use.
INFERENCE_BACKEND_MODE=demo

# Browser-safe, credential-free RPC/explorer build configuration.
# Apply the same NEXT_PUBLIC_RH_RPC_URL to build and Agent startup so its CSP
# permits that public origin. Never use a credentialed provider RPC here.
NEXT_PUBLIC_RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_RH_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# No plan price/duration environment variables exist. No provider backend URL,
# model server, backend credential, GPU requirement, or tunnel credential exists
# for P0. OmniRoute route facts must come from operator verification, never guesses.
